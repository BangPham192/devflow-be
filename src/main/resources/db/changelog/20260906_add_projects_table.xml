<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="20261024_add_projects_table" author="bang.pham">
        <createTable tableName="projects">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="public_id" type="binary(16)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="workspace_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="datetime"/>
            <column name="updated_at" type="datetime"/>
        </createTable>
        <modifySql dbms="mysql">
            <append value="engine innodb"/>
        </modifySql>
    </changeSet>

    <changeSet id="20261024_add_projects_table_index" author="bang.pham">
        <!-- serves: list projects of a workspace (filter by workspace_id, status) -->
        <createIndex tableName="projects" indexName="idx_projects_workspace_id_status">
            <column name="workspace_id"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>