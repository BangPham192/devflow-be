<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="20260906_add_workspace_invitations_table" author="bang.pham">
        <createTable tableName="workspace_invitations">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>

            <column name="public_id" type="binary(16)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="workspace_id" type="bigint">
                <constraints foreignKeyName="fk_workspace_invitations_workspace_id" references="workspaces(id)" nullable="false"/>
            </column>
            <column name="inviter_id" type="bigint">
                <constraints foreignKeyName="fk_workspace_invitations_inviter_id" references="users(id)" nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role_name" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_at" type="datetime">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="datetime"/>
            <column name="updated_at" type="datetime"/>
        </createTable>
        <modifySql dbms="mysql">
            <append value="engine innodb"/>
        </modifySql>
    </changeSet>
</databaseChangeLog>